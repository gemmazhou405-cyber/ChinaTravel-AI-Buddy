# Frontend-safe payment mode. Keep production on manual until Sandbox QA is approved.
VITE_PAYMENT_MODE=manual

# Cloudflare Pages Functions secrets / environment variables.
PAYMENT_MODE=manual
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
FIREBASE_PROJECT_ID=chinaease-buddy
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ALLOWED_ORIGINS=https://chinaeasebuddy.com,http://localhost:5173,http://127.0.0.1:5173
# Secret salt for hashing visitor IP addresses (rate limits, free-plan limits). Set as a
# Cloudflare Pages secret, e.g. the output of `openssl rand -hex 32`. Changing it resets IP limits.
IP_HASH_SALT=

# Buddy AI server-side proxy. Keep these in Cloudflare Pages Functions env/secrets.
COZE_WORKER_URL=
COZE_BOT_ID=
COZE_INTERNAL_SECRET=

# DeepSeek itinerary generation. Keep this server-side in Cloudflare Pages secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_ITINERARY_MODEL=deepseek-chat

# Trip itinerary email delivery and Resend delivery-status webhook.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TRIP_LEAD_FROM_EMAIL=ChinaEase Buddy <leads@notify.chinaeasebuddy.com>
# Optional: sender of the customer itinerary email. Defaults to
# "Lin from ChinaEase Buddy <lin@chinaeasebuddy.com>" (needs chinaeasebuddy.com verified in Resend).
TRIP_CUSTOMER_FROM_EMAIL=

# Optional WhatsApp Business Cloud API reminder. The template must be approved by Meta.
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Gumroad webhook automation. Set GUMROAD_WEBHOOK_SECRET to any random string (32+ chars).
# Add ?secret=<GUMROAD_WEBHOOK_SECRET> to the end of the Ping URL in Gumroad Settings > Advanced.
# These credentials and IDs are Functions-only; never prefix them with VITE_.
GUMROAD_ACCESS_TOKEN=
GUMROAD_TRIP_PRODUCT_ID=
GUMROAD_GROUP_PRODUCT_ID=
GUMROAD_WEBHOOK_SECRET=
GUMROAD_TRIP_PERMALINK=oentc
GUMROAD_GROUP_PERMALINK=mbgkxz
SESSION_SECRET=
# Public checkout URLs must resolve to the same products as the IDs above.
VITE_GUMROAD_TRIP_URL=
VITE_GUMROAD_GROUP_URL=

# Manual admin activation endpoint. Set ADMIN_SECRET to any random string (32+ chars).
# Usage: POST /api/admin/activate with Authorization: Bearer <ADMIN_SECRET>
ADMIN_SECRET=
